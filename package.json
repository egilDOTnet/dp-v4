{
  "name": "dp-v4",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test --filter=@dp/api && turbo run test --filter='!@dp/api'",
    "test:parallel": "turbo run test",
    "test:setup": "pnpm --filter @dp/db db:setup-test",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.7.2"
  },
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "bcrypt",
      "esbuild",
      "prisma",
      "sharp"
    ],
    "ignoredBuiltDependencies": [
      "msw",
      "unrs-resolver"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19",
        "react-dom": "19",
        "@types/react": "19"
      }
    },
    "overrides": {
      "qs": ">=6.14.1"
    }
  }
}
