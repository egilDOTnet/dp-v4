generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Phase {
  id        String   @id
  projectId String
  name      String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime
  Project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  Task      Task[]

  @@index([projectId])
  @@index([projectId, order])
}

model Project {
  id            String          @id
  name          String
  type          String?
  startDate     DateTime?
  endDate       DateTime?
  tenantId      String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  Phase         Phase[]
  Tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ProjectMember ProjectMember[]
  requirementHierarchies RequirementHierarchy[]

  @@index([tenantId])
}

model ProjectMember {
  id        String   @id
  projectId String
  userId    String
  createdAt DateTime @default(now())
  Project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model Task {
  id                   String    @id @default(cuid())
  phaseId              String
  name                 String
  description          String?
  link                 String?
  ownerId              String?
  startDate            DateTime?
  plannedCompletionDate DateTime?
  actualCompletionDate DateTime?
  order                Int
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  phase Phase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  owner User?  @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([phaseId])
  @@index([phaseId, order])
  @@index([ownerId])
}

model Template {
  id        String   @id
  name      String
  content   String?  @default("")
  isGlobal  Boolean  @default(false)
  tenantId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime
  Tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([isGlobal])
  @@index([tenantId])
}

model Tenant {
  id        String     @id
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime
  Project   Project[]
  Template  Template[]
  User      User[]

  @@index([name])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  firstName    String?
  lastName     String?
  passwordHash String?
  tenantId     String?
  role         Role     @default(User)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant                Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectMembers        ProjectMember[]
  ownedTasks            Task[]
  createdRequirements   Requirement[]           @relation("RequirementCreator")
  modifiedRequirements  Requirement[]            @relation("RequirementModifier")
  requirementHistories  RequirementHistory[]

  @@index([email])
  @@index([tenantId])
}

model RequirementHierarchy {
  id          String   @id @default(cuid())
  projectId   String
  parentId    String?
  number      String
  title       String
  description String?
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent      RequirementHierarchy? @relation("HierarchyParent", fields: [parentId], references: [id], onDelete: Cascade)
  children    RequirementHierarchy[] @relation("HierarchyParent")
  requirements Requirement[]

  @@index([projectId])
  @@index([parentId])
  @@index([projectId, parentId, order])
}

model Requirement {
  id              String              @id @default(cuid())
  hierarchyId     String
  number          String
  description     String
  type            RequirementType
  status          RequirementStatus
  order           Int
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  createdById     String
  lastModifiedById String

  hierarchy       RequirementHierarchy @relation(fields: [hierarchyId], references: [id], onDelete: Cascade)
  createdBy       User                 @relation("RequirementCreator", fields: [createdById], references: [id], onDelete: Restrict)
  lastModifiedBy  User                 @relation("RequirementModifier", fields: [lastModifiedById], references: [id], onDelete: Restrict)
  history         RequirementHistory[]

  @@index([hierarchyId])
  @@index([hierarchyId, order])
}

model RequirementHistory {
  id            String          @id @default(cuid())
  requirementId String
  description   String
  type          RequirementType
  status        RequirementStatus
  modifiedById  String
  createdAt     DateTime         @default(now())

  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  modifiedBy    User        @relation(fields: [modifiedById], references: [id], onDelete: Restrict)

  @@index([requirementId])
}

enum RequirementType {
  Information
  Mandatory
  Important
  Wish
}

enum RequirementStatus {
  Approved
  ForReview
  New
}

enum Role {
  GlobalAdministrator
  CompanyAdministrator
  User
  Vendor
}
